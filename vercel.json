{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|uploads/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{artisan_marketplace.db,backend/**,uploads/**}",
      "maxDuration": 60
    },
    "api/[...path].py": {
      "includeFiles": "{artisan_marketplace.db,backend/**,uploads/**}",
      "maxDuration": 60
    }
  }
}
