{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path__=/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.py?__path__=/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{artisan_marketplace.db,backend/**,uploads/**}",
      "maxDuration": 60
    }
  }
}
