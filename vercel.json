{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|uploads/|css/|js/|static/|favicon\\.ico|.*\\.[a-zA-Z0-9]+).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/*.py": {
      "includeFiles": "{artisan_marketplace.db,backend/**}",
      "maxDuration": 60
    }
  }
}
