{
  "expo": {
    "name": "KalaSetu AI",
    "slug": "kalasetu-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FAF6EF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.kalasetu.mobile"
    },
    "android": {
      "package": "ai.kalasetu.mobile",
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KalaSetu AI to access your photos to list handmade products.",
          "cameraPermission": "Allow KalaSetu AI to use your camera to photograph handmade products."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ]
  }
}
