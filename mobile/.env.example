# Replace with your machine's LAN IP when testing on a physical device.
# Android emulators use http://10.0.2.2:8000 automatically when this is unset.
# e.g. EXPO_PUBLIC_API_URL=http://192.168.1.5:8000
EXPO_PUBLIC_API_URL=http://192.168.1.5:8000

# Optional: live AI vision (backend also reads this; never put keys in the app bundle)
# GEMINI_API_KEY=
